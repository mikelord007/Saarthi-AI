    <string name="assistant_screen_body">Saarthi AI ला आपला असिस्टंट बनवा, म्हणजे होम बटण दीर्घकाळ दाबल्यावर, आपण जे काही करत असाल त्यावर मी येईन.</string>
    <string name="set_as_assistant">असिस्टंट म्हणून सेट करा</string>

    <!-- Onboarding: Promise -->
    <string name="my_promise">माझे वचन</string>
    <string name="promise_headline">मी कधीही आपले पैसे खर्च करत नाही.</string>
    <string name="promise_body_prefix">मी ॲप्स उघडू शकतो, फॉर्म भरू शकतो आणि आपली राईड निवडू शकतो. पण कोणतेही पेमेंट, कोणतेही पाठवणे, कोणतीही पुष्टी करण्यापूर्वी — मी थांबतो, काय होणार आहे ते मोठ्याने सांगतो, आणि </string>

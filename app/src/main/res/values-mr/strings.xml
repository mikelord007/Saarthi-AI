    <!-- Onboarding: Mic -->
    <string name="mic_screen_title">मी मायक्रोफोन वापरू का?</string>
    <string name="mic_screen_body">फक्त आपण माझ्याशी बोलत असताना. मी पार्श्वभूमीत ऐकत नाही, आणि कार्य संपल्यानंतर काहीही रेकॉर्ड केले जात नाही.</string>
    <string name="mic_screen_note_prefix">Android आता आपल्याला विचारेल. निवडा </string>
    <string name="mic_screen_note_highlight">\"ॲप वापरताना\".</string>
    <string name="allow_microphone">मायक्रोफोनला परवानगी द्या</string>

    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">मला स्क्रीन वाचू द्या</string>
    <string name="a11y_screen_body">ही एक ॲक्सेसिबिलिटी सेवा आहे. ती फक्त आपल्या स्क्रीनवरील लेबल्स वाचते — कधीही चित्रे नाही, कधीही आपला कीबोर्ड नाही.</string>
    <string name="a11y_row_1">बटण आणि मजकूर लेबल्स वाचते</string>
    <string name="a11y_row_2">आपल्या वतीने टॅप आणि टाइप करते</string>
    <string name="a11y_row_3">कधीही स्क्रीनशॉट किंवा फोटो घेत नाही</string>
    <string name="open_android_settings">Android सेटिंग्ज उघडा</string>
    <string name="a11y_settings_path">Settings → Accessibility → Saarthi AI → On</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">आपल्या स्क्रीनवरील बटण आणि मजकूर लेबल्स वाचते, आणि आपण Saarthi ला एखादे कार्य करण्यास सांगितल्यावर आपल्या वतीने टॅप किंवा टाइप करते. कधीही स्क्रीनशॉट घेत नाही किंवा आपला कीबोर्ड वाचत नाही.</string>
    <string name="a11y_required_notice">हे करण्यासाठी मला ॲक्सेसिबिलिटी परवानगी चालू असणे आवश्यक आहे — कृपया ती सेटिंग्जमध्ये सुरू करा.</string>

    <!-- Onboarding: Assistant -->

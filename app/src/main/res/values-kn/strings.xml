    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">ಪರದೆಯನ್ನು ಓದಲು ನನಗೆ ಅವಕಾಶ ಕೊಡಿ</string>
    <string name="a11y_screen_body">ಇದು ಒಂದು ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಸೇವೆ. ಇದು ನಿಮ್ಮ ಪರದೆಯ ಮೇಲಿನ ಲೇಬಲ್‌ಗಳನ್ನು ಓದುತ್ತದೆ — ಚಿತ್ರಗಳನ್ನಲ್ಲ, ನಿಮ್ಮ ಕೀಬೋರ್ಡ್ ಅನ್ನಲ್ಲ.</string>
    <string name="a11y_row_1">ಬಟನ್ ಮತ್ತು ಪಠ್ಯ ಲೇಬಲ್‌ಗಳನ್ನು ಓದುತ್ತದೆ</string>
    <string name="a11y_row_2">ನಿಮ್ಮ ಪರವಾಗಿ ಟ್ಯಾಪ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ಟೈಪ್ ಮಾಡುತ್ತದೆ</string>
    <string name="a11y_row_3">ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅಥವಾ ಫೋಟೋ ಎಂದಿಗೂ ತೆಗೆದುಕೊಳ್ಳುವುದಿಲ್ಲ</string>
    <string name="open_android_settings">Android ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ</string>
    <string name="a11y_settings_path">ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ → Saarthi AI → ಆನ್</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">ನಿಮ್ಮ ಪರದೆಯ ಮೇಲಿನ ಬಟನ್ ಮತ್ತು ಪಠ್ಯ ಲೇಬಲ್‌ಗಳನ್ನು ಓದುತ್ತದೆ, ಮತ್ತು ನೀವು Saarthi ಗೆ ಒಂದು ಕಾರ್ಯ ಮಾಡಲು ಕೇಳಿದಾಗ ನಿಮ್ಮ ಪರವಾಗಿ ಟ್ಯಾಪ್ ಅಥವಾ ಟೈಪ್ ಮಾಡುತ್ತದೆ. ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ತೆಗೆದುಕೊಳ್ಳುವುದಿಲ್ಲ ಅಥವಾ ನಿಮ್ಮ ಕೀಬೋರ್ಡ್ ಓದುವುದಿಲ್ಲ.</string>
    <string name="a11y_required_notice">ಇದನ್ನು ಮಾಡಲು ನನಗೆ ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಅನುಮತಿ ಆನ್ ಆಗಿರಬೇಕು — ದಯವಿಟ್ಟು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.</string>


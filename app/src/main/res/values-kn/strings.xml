    <!-- Onboarding: Welcome -->
    <string name="welcome_kicker">ಸ್ವಲ್ಪ ತಾಳಿ. ನಾನು ನಿಮಗೆ ಎಲ್ಲವನ್ನೂ ತೋರಿಸುತ್ತೇನೆ.</string>
    <string name="welcome_body">ನಿಮಗೆ ಏನು ಮಾಡಬೇಕೋ ಅದನ್ನು ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ನನಗೆ ಹೇಳಿ. ನಾನು ಪರದೆಯನ್ನು ಗಟ್ಟಿಯಾಗಿ ಓದುತ್ತೇನೆ, ಅಥವಾ ನಿಮಗಾಗಿ ಟ್ಯಾಪ್ ಮಾಡುತ್ತೇನೆ — ಮತ್ತು ಪ್ರತಿ ಹಂತವನ್ನು ಮಾಡುವ ಮೊದಲು ಅದನ್ನು ಹೇಳುತ್ತೇನೆ.</string>
    <string name="begin">ಪ್ರಾರಂಭಿಸಿ</string>
    <string name="welcome_footer">ಸುಮಾರು ಒಂದು ನಿಮಿಷ ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ · ನಾಲ್ಕು ಅನುಮತಿಗಳು</string>


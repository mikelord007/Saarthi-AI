    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">મને સ્ક્રીન વાંચવા દો</string>
    <string name="a11y_screen_body">આ એક ઍક્સેસિબિલિટી સેવા છે. તે તમારી સ્ક્રીન પરના લેબલ વાંચે છે — ક્યારેય ચિત્રો નહીં, ક્યારેય તમારું કીબોર્ડ નહીં.</string>
    <string name="a11y_row_1">બટન અને ટેક્સ્ટ લેબલ વાંચે છે</string>
    <string name="a11y_row_2">તમારા વતી ટૅપ અને ટાઇપ કરે છે</string>
    <string name="a11y_row_3">ક્યારેય સ્ક્રીનશોટ કે ફોટા લેતું નથી</string>
    <string name="open_android_settings">Android સેટિંગ્સ ખોલો</string>
    <string name="a11y_settings_path">સેટિંગ્સ → ઍક્સેસિબિલિટી → Saarthi AI → ચાલુ</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">તમારી સ્ક્રીન પરના બટન અને ટેક્સ્ટ લેબલ વાંચે છે, અને જ્યારે તમે Saarthi ને કોઈ કાર્ય કરવા કહો ત્યારે તમારા વતી ટૅપ કે ટાઇપ કરે છે. ક્યારેય સ્ક્રીનશોટ લેતું નથી કે તમારું કીબોર્ડ વાંચતું નથી.</string>
    <string name="a11y_required_notice">આ કરવા માટે મારે ઍક્સેસિબિલિટી પરવાનગી ચાલુ કરવાની જરૂર છે — કૃપા કરીને તેને સેટિંગ્સમાં સક્ષમ કરો.</string>


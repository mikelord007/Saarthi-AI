    <!-- Onboarding: Welcome -->
    <string name="welcome_kicker">కాస్త ఆగండి. నేను మీకు అన్నీ చూపిస్తాను.</string>
    <string name="welcome_body">మీకు ఏం కావాలో మీ భాషలో చెప్పండి. నేను స్క్రీన్‌ను చదివి వినిపిస్తాను, లేదా మీ తరపున నొక్కుతాను — ప్రతి దశనూ చేసే ముందు మీకు చెప్తాను.</string>
    <string name="begin">ప్రారంభించండి</string>
    <string name="welcome_footer">దాదాపు ఒక నిమిషం పడుతుంది · నాలుగు అనుమతులు</string>

    <!-- Onboarding: Language -->
    <string name="language_screen_title">నేను ఏ భాషలో మాట్లాడాలి?</string>
    <string name="language_screen_body">నేను ఈ భాషలోనే వింటాను కూడా. సెట్టింగ్‌లలో ఎప్పుడైనా మార్చవచ్చు.</string>
    <string name="language_screen_count" tools:ignore="PluralsCandidate">%1$d భాషలు · మరిన్ని రాబోతున్నాయి</string>

    <!-- Onboarding: Voice -->
    <string name="voice_screen_title">నేను ఎవరి స్వరాన్ని వాడాలి?</string>
    <string name="voice_screen_body">వినడానికి ఒకదాన్ని నొక్కండి, అది మీకు ఒక వాక్యం చదివి వినిపిస్తుంది.</string>
    <string name="onboarding_voice_sample_line">నమస్కారం, నేను Saarthi, మీ అసిస్టెంట్‌ని.</string>
    <string name="use_this_voice">ఈ స్వరాన్ని వాడండి</string>

    <!-- Onboarding: Mic -->
    <string name="mic_screen_title">నేను మైక్రోఫోన్ వాడవచ్చా?</string>
    <string name="mic_screen_body">మీరు నాతో మాట్లాడుతున్నప్పుడు మాత్రమే. నేను వెనుకనుండి వినను, పని పూర్తయిన తర్వాత ఏమీ రికార్డు కాదు.</string>
    <string name="mic_screen_note_prefix">తర్వాత Android మిమ్మల్ని అడుగుతుంది. ఎంచుకోండి </string>
    <string name="mic_screen_note_highlight">\"యాప్ వాడుతున్నప్పుడు\".</string>
    <string name="allow_microphone">మైక్రోఫోన్‌ను అనుమతించండి</string>

    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">నన్ను స్క్రీన్ చదవనివ్వండి</string>
    <string name="a11y_screen_body">ఇది ఒక యాక్సెసిబిలిటీ సేవ. ఇది మీ స్క్రీన్‌పై ఉన్న లేబుల్‌లను చదువుతుంది — చిత్రాలను కాదు, మీ కీబోర్డును అస్సలు కాదు.</string>
    <string name="a11y_row_1">బటన్లు, టెక్స్ట్ లేబుల్‌లను చదువుతుంది</string>
    <string name="a11y_row_2">మీ తరపున నొక్కుతుంది, టైప్ చేస్తుంది</string>
    <string name="a11y_row_3">స్క్రీన్‌షాట్‌లు లేదా ఫోటోలు ఎప్పుడూ తీయదు</string>
    <string name="open_android_settings">Android సెట్టింగ్‌లను తెరవండి</string>
    <string name="a11y_settings_path">సెట్టింగ్‌లు → యాక్సెసిబిలిటీ → Saarthi AI → ఆన్</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">మీ స్క్రీన్‌పై ఉన్న బటన్లు, టెక్స్ట్ లేబుల్‌లను చదువుతుంది, మీరు Saarthiని ఒక పని చేయమని అడిగినప్పుడు మీ తరపున నొక్కుతుంది లేదా టైప్ చేస్తుంది. స్క్రీన్‌షాట్‌లు తీయదు, మీ కీబోర్డును ఎప్పుడూ చదవదు.</string>
    <string name="a11y_required_notice">దీన్ని చేయడానికి నాకు యాక్సెసిబిలిటీ అనుమతి ఆన్‌లో ఉండాలి — దయచేసి దాన్ని సెట్టింగ్‌లలో ఎనేబుల్ చేయండి.</string>

    <!-- Onboarding: Assistant -->
    <string name="assistant_screen_title">నా కోసం హోమ్ బటన్‌ను నొక్కి పట్టుకోండి</string>
    <string name="assistant_screen_body">Saarthi AIని మీ అసిస్టెంట్‌గా చేయండి, హోమ్‌ను నొక్కిపట్టుకుంటే మీరు ఏం చేస్తున్నా దాని పైన నేను ప్రత్యక్షమవుతాను.</string>
    <string name="set_as_assistant">అసిస్టెంట్‌గా సెట్ చేయండి</string>

    <!-- Onboarding: Promise -->
    <string name="my_promise">నా వాగ్దానం</string>
    <string name="promise_headline">నేను మీ డబ్బును ఎప్పుడూ ఖర్చు చేయను.</string>
    <string name="promise_body_prefix">నేను యాప్‌లను తెరవగలను, ఫారాలు నింపగలను, మీ రైడ్‌ను ఎంచుకోగలను. కానీ ఏదైనా చెల్లింపు, పంపడం, నిర్ధారణకు ముందు — నేను ఆగిపోతాను, జరగబోయేది గట్టిగా చెప్తాను, ఆపై </string>
    <string name="promise_body_you">మీరే</string>
    <string name="promise_body_suffix"> చివరి నొక్కును చేస్తారు.</string>
    <string name="promise_cta">అర్థమైంది — వెళ్దాం</string>


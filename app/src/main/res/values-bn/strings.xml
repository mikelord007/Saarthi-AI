    <string name="a11y_screen_body">এটি একটি অ্যাক্সেসিবিলিটি পরিষেবা। এটি আপনার স্ক্রিনের লেবেলগুলো পড়ে—কখনও ছবি নয়, কখনও আপনার কিবোর্ড নয়।</string>
    <string name="a11y_row_1">বোতাম ও টেক্সট লেবেল পড়ে</string>
    <string name="a11y_row_2">আপনার হয়ে চাপ দেয় ও টাইপ করে</string>
    <string name="a11y_row_3">কখনও স্ক্রিনশট বা ছবি তোলে না</string>
    <string name="open_android_settings">Android সেটিংস খুলুন</string>
    <string name="a11y_settings_path">সেটিংস → অ্যাক্সেসিবিলিটি → Saarthi AI → চালু</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">আপনার স্ক্রিনের বোতাম ও টেক্সট লেবেল পড়ে, এবং আপনি Saarthi-কে কোনো কাজ করতে বললে আপনার হয়ে চাপ দেয় বা টাইপ করে। কখনও স্ক্রিনশট নেয় না বা আপনার কিবোর্ড পড়ে না।</string>
    <string name="a11y_required_notice">এটি করার জন্য আমার অ্যাক্সেসিবিলিটি অনুমতি চালু থাকা দরকার—দয়া করে সেটিংসে গিয়ে এটি চালু করুন।</string>


    <!-- Onboarding: Welcome -->
    <string name="welcome_kicker">ഒരു നിമിഷം. ഞാൻ നിങ്ങളെ കൂടെ കൊണ്ടുപോകാം.</string>
    <string name="welcome_body">നിങ്ങൾക്ക് എന്താണ് വേണ്ടതെന്ന് നിങ്ങളുടെ ഭാഷയിൽ എന്നോട് പറയൂ. ഞാൻ സ്ക്രീൻ ഉറക്കെ വായിക്കും, അല്ലെങ്കിൽ നിങ്ങൾക്കുവേണ്ടി ടാപ്പ് ചെയ്യും — ഓരോ ഘട്ടവും ചെയ്യുന്നതിനു മുൻപ് ഞാൻ അത് പറയും.</string>
    <string name="begin">തുടങ്ങാം</string>
    <string name="welcome_footer">ഏകദേശം ഒരു മിനിറ്റ് · നാല് അനുമതികൾ</string>


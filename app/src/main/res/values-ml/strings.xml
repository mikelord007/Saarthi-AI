    <!-- Onboarding: Promise -->
    <string name="my_promise">എന്റെ വാഗ്ദാനം</string>
    <string name="promise_headline">ഞാൻ ഒരിക്കലും നിങ്ങളുടെ പണം ചെലവഴിക്കില്ല.</string>
    <string name="promise_body_prefix">എനിക്ക് ആപ്പുകൾ തുറക്കാം, ഫോമുകൾ പൂരിപ്പിക്കാം, നിങ്ങളുടെ റൈഡ് തിരഞ്ഞെടുക്കാം. പക്ഷേ ഏതെങ്കിലും പണമടയ്ക്കൽ, അയയ്ക്കൽ, സ്ഥിരീകരണം എന്നിവയ്ക്കു മുൻപ് — ഞാൻ നിർത്തും, എന്താണ് സംഭവിക്കാൻ പോകുന്നതെന്ന് ഉറക്കെ പറയും, </string>
    <string name="promise_body_you">നിങ്ങൾ</string>
    <string name="promise_body_suffix"> ആണ് അവസാന ടാപ്പ് ചെയ്യുന്നത്.</string>
    <string name="promise_cta">മനസ്സിലായി — നമുക്ക് തുടങ്ങാം</string>


    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">मुझे स्क्रीन पढ़ने दें</string>
    <string name="a11y_screen_body">यह एक एक्सेसिबिलिटी सेवा है। यह आपकी स्क्रीन के लेबल पढ़ती है — कभी तस्वीरें नहीं, कभी आपका कीबोर्ड नहीं।</string>
    <string name="a11y_row_1">बटन और टेक्स्ट लेबल पढ़ती है</string>
    <string name="a11y_row_2">आपकी ओर से टैप और टाइप करती है</string>
    <string name="a11y_row_3">कभी स्क्रीनशॉट या फ़ोटो नहीं लेती</string>
    <string name="open_android_settings">Android सेटिंग्स खोलें</string>
    <string name="a11y_settings_path">Settings → Accessibility → Saarthi AI → On</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">यह आपकी स्क्रीन पर बटन और टेक्स्ट लेबल पढ़ती है, और जब आप Saarthi से कोई कार्य करने को कहते हैं तो आपकी ओर से टैप या टाइप करती है। यह कभी स्क्रीनशॉट नहीं लेती और न ही आपका कीबोर्ड पढ़ती है।</string>
    <string name="a11y_required_notice">यह करने के लिए मुझे एक्सेसिबिलिटी अनुमति चालू होनी चाहिए — कृपया इसे सेटिंग्स में चालू करें।</string>


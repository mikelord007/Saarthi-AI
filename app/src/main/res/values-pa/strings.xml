    <!-- Onboarding: Welcome -->
    <string name="welcome_kicker">ਰੁਕੋ। ਮੈਂ ਤੁਹਾਨੂੰ ਸਮਝਾਉਂਦਾ ਹਾਂ।</string>
    <string name="welcome_body">ਮੈਨੂੰ ਆਪਣੀ ਭਾਸ਼ਾ ਵਿੱਚ ਦੱਸੋ ਕਿ ਤੁਸੀਂ ਕੀ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ। ਮੈਂ ਸਕਰੀਨ ਉੱਚੀ ਆਵਾਜ਼ ਵਿੱਚ ਪੜ੍ਹਦਾ ਹਾਂ, ਜਾਂ ਤੁਹਾਡੇ ਲਈ ਟੈਪ ਕਰਦਾ ਹਾਂ — ਅਤੇ ਹਰ ਕਦਮ ਚੁੱਕਣ ਤੋਂ ਪਹਿਲਾਂ ਉਸ ਬਾਰੇ ਦੱਸਦਾ ਹਾਂ।</string>
    <string name="begin">ਸ਼ੁਰੂ ਕਰੋ</string>
    <string name="welcome_footer">ਲਗਭਗ ਇੱਕ ਮਿੰਟ ਲੱਗਦਾ ਹੈ · ਚਾਰ ਇਜਾਜ਼ਤਾਂ</string>


    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">ਮੈਨੂੰ ਸਕਰੀਨ ਪੜ੍ਹਨ ਦਿਓ</string>
    <string name="a11y_screen_body">ਇਹ ਇੱਕ ਪਹੁੰਚਯੋਗਤਾ ਸੇਵਾ ਹੈ। ਇਹ ਤੁਹਾਡੀ ਸਕਰੀਨ ਦੇ ਲੇਬਲ ਪੜ੍ਹਦੀ ਹੈ — ਕਦੇ ਵੀ ਤਸਵੀਰਾਂ ਨਹੀਂ, ਕਦੇ ਵੀ ਤੁਹਾਡਾ ਕੀਬੋਰਡ ਨਹੀਂ।</string>
    <string name="a11y_row_1">ਬਟਨ ਅਤੇ ਟੈਕਸਟ ਲੇਬਲ ਪੜ੍ਹਦੀ ਹੈ</string>
    <string name="a11y_row_2">ਤੁਹਾਡੀ ਤਰਫ਼ੋਂ ਟੈਪ ਅਤੇ ਟਾਈਪ ਕਰਦੀ ਹੈ</string>
    <string name="a11y_row_3">ਕਦੇ ਵੀ ਸਕ੍ਰੀਨਸ਼ਾਟ ਜਾਂ ਫੋਟੋ ਨਹੀਂ ਲੈਂਦੀ</string>
    <string name="open_android_settings">ਐਂਡਰਾਇਡ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ</string>
    <string name="a11y_settings_path">ਸੈਟਿੰਗਾਂ → ਪਹੁੰਚਯੋਗਤਾ → Saarthi AI → ਚਾਲੂ</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">ਤੁਹਾਡੀ ਸਕਰੀਨ ਦੇ ਬਟਨ ਅਤੇ ਟੈਕਸਟ ਲੇਬਲ ਪੜ੍ਹਦੀ ਹੈ, ਅਤੇ ਜਦੋਂ ਤੁਸੀਂ Saarthi AI ਨੂੰ ਕੋਈ ਕੰਮ ਕਰਨ ਲਈ ਕਹਿੰਦੇ ਹੋ ਤਾਂ ਤੁਹਾਡੀ ਤਰਫ਼ੋਂ ਟੈਪ ਜਾਂ ਟਾਈਪ ਕਰਦੀ ਹੈ। ਕਦੇ ਵੀ ਸਕ੍ਰੀਨਸ਼ਾਟ ਨਹੀਂ ਲੈਂਦੀ ਜਾਂ ਤੁਹਾਡਾ ਕੀਬੋਰਡ ਨਹੀਂ ਪੜ੍ਹਦੀ।</string>
    <string name="a11y_required_notice">ਇਹ ਕਰਨ ਲਈ ਮੈਨੂੰ ਪਹੁੰਚਯੋਗਤਾ ਦੀ ਇਜਾਜ਼ਤ ਚਾਲੂ ਚਾਹੀਦੀ ਹੈ — ਕਿਰਪਾ ਕਰਕੇ ਇਸਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।</string>


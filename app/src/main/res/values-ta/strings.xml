    <!-- Onboarding: Welcome -->
    <string name="welcome_kicker">ஒரு நிமிடம். நான் உங்களுக்கு வழிகாட்டுகிறேன்.</string>
    <string name="welcome_body">நீங்கள் என்ன செய்ய விரும்புகிறீர்கள் என்று உங்கள் மொழியில் சொல்லுங்கள். நான் திரையை உரக்கப் படித்துக் காட்டுவேன், அல்லது உங்களுக்காகத் தட்டுவேன் — ஒவ்வொரு படியையும் செய்வதற்கு முன் நான் அதைச் சொல்வேன்.</string>
    <string name="begin">தொடங்குங்கள்</string>
    <string name="welcome_footer">சுமார் ஒரு நிமிடம் ஆகும் · நான்கு அனுமதிகள்</string>

    <!-- Onboarding: Language -->
    <string name="language_screen_title">நான் எந்த மொழியில் பேசவேண்டும்?</string>
    <string name="language_screen_body">நான் இதே மொழியில் கேட்பேன். அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றிக்கொள்ளலாம்.</string>
    <string name="language_screen_count" tools:ignore="PluralsCandidate">%1$d மொழிகள் · மேலும் வரவுள்ளன</string>

    <!-- Onboarding: Voice -->
    <string name="voice_screen_title">நான் யாருடைய குரலைப் பயன்படுத்தவேண்டும்?</string>
    <string name="voice_screen_body">ஒன்றைத் தட்டி, அது உங்களுக்கு ஒரு வரியைப் படித்துக் காட்டுவதைக் கேளுங்கள்.</string>
    <string name="onboarding_voice_sample_line">Ola கிடைத்தது. இப்போது திறக்கிறேன்.</string>
    <string name="use_this_voice">இந்தக் குரலைப் பயன்படுத்து</string>

    <!-- Onboarding: Mic -->
    <string name="mic_screen_title">மைக்ரோஃபோனைப் பயன்படுத்தலாமா?</string>
    <string name="mic_screen_body">நீங்கள் என்னிடம் பேசும்போது மட்டுமே. நான் பின்னணியில் கேட்க மாட்டேன், பணி முடிந்த பிறகு எதுவும் பதிவு செய்யப்படாது.</string>
    <string name="mic_screen_note_prefix">அடுத்து Android உங்களைக் கேட்கும். இதைத் தேர்ந்தெடுக்கவும்: </string>
    <string name="mic_screen_note_highlight">\"ஆப்பைப் பயன்படுத்தும்போது\".</string>
    <string name="allow_microphone">மைக்ரோஃபோனை அனுமதி</string>

    <!-- Onboarding: Accessibility -->
    <string name="a11y_screen_title">திரையைப் படிக்க என்னை அனுமதியுங்கள்</string>
    <string name="a11y_screen_body">இது ஒரு அணுகல்தன்மை சேவை. இது உங்கள் திரையில் உள்ள லேபிள்களை மட்டும் படிக்கும் — படங்களை ஒருபோதும் அல்ல, உங்கள் கீபோர்டையும் ஒருபோதும் அல்ல.</string>
    <string name="a11y_row_1">பொத்தான் மற்றும் உரை லேபிள்களைப் படிக்கும்</string>
    <string name="a11y_row_2">உங்களுக்காகத் தட்டி, தட்டச்சு செய்யும்</string>
    <string name="a11y_row_3">ஸ்கிரீன்ஷாட் அல்லது புகைப்படங்கள் ஒருபோதும் எடுக்காது</string>
    <string name="open_android_settings">Android அமைப்புகளைத் திற</string>
    <string name="a11y_settings_path">அமைப்புகள் → அணுகல்தன்மை → Saarthi AI → இயக்கத்தில்</string>
    <string name="a11y_service_label">Saarthi AI</string>
    <string name="a11y_service_description">உங்கள் திரையில் உள்ள பொத்தான் மற்றும் உரை லேபிள்களைப் படிக்கும், நீங்கள் Saarthi-யிடம் ஒரு பணியைச் செய்யச் சொன்னால் உங்களுக்காகத் தட்டும் அல்லது தட்டச்சு செய்யும். ஸ்கிரீன்ஷாட் ஒருபோதும் எடுக்காது, உங்கள் கீபோர்டையும் படிக்காது.</string>
    <string name="a11y_required_notice">இதைச் செய்ய அணுகல்தன்மை அனுமதி இயக்கத்தில் இருக்க வேண்டும் — தயவுசெய்து அமைப்புகளில் அதை இயக்குங்கள்.</string>

    <!-- Onboarding: Assistant -->
    <string name="assistant_screen_title">எனக்காக ஹோம் பொத்தானை அழுத்திப் பிடியுங்கள்</string>
    <string name="assistant_screen_body">Saarthi AI-ஐ உங்கள் உதவியாளராக அமையுங்கள், ஹோம் பொத்தானை நீண்ட நேரம் அழுத்தினால், நீங்கள் என்ன செய்துகொண்டிருந்தாலும் அதன் மேலே நான் தோன்றுவேன்.</string>
    <string name="set_as_assistant">உதவியாளராக அமை</string>

    <!-- Onboarding: Promise -->
    <string name="my_promise">என் வாக்குறுதி</string>
    <string name="promise_headline">நான் ஒருபோதும் உங்கள் பணத்தைச் செலவழிக்க மாட்டேன்.</string>
    <string name="promise_body_prefix">நான் ஆப்களைத் திறக்கலாம், படிவங்களை நிரப்பலாம், உங்கள் வாகனத்தைத் தேர்வு செய்யலாம். ஆனால் எந்தப் பணம் செலுத்துவதற்கு முன்பும், அனுப்புவதற்கு முன்பும், உறுதிப்படுத்துவதற்கு முன்பும் — நான் நிறுத்திவிட்டு, என்ன நடக்கவிருக்கிறது என்பதை உரக்கச் சொல்வேன், மேலும் </string>
    <string name="promise_body_you">நீங்கள்</string>
    <string name="promise_body_suffix"> கடைசி தட்டலைச் செய்வீர்கள்.</string>
    <string name="promise_cta">புரிந்தது — செல்வோம்</string>

    <!-- Hand-back -->
    <string name="handback_kicker">நான் இங்கே நிறுத்துகிறேன்</string>
    <string name="handback_action_question">%1$s?</string>
    <string name="handback_body">நான் இதை உங்களுக்காகச் செய்யவிருந்தேன். இதை நீங்களே முடிக்க வேண்டும்.</string>
    <string name="handback_footer">இது உங்கள் முடிவு. நான் இதை உங்களுக்காகத் தட்ட மாட்டேன்.</string>
    <string name="handback_confirm_label">ஆம் — நான் இதை நானே செய்கிறேன்</string>
    <string name="handback_decline_label">இல்லை, நிறுத்து</string>

    <!-- Invoke sheet (system assistant-slot entry point) -->
    <string name="invoke_listening_title">நான் கேட்கிறேன்.</string>
    <string name="invoke_listening_prompt">%1$s மொழியில் உங்களுக்கு வேண்டியதைச் சொல்லுங்கள்.</string>
    <string name="invoke_read_screen_button">இந்தத் திரையை உரக்கப் படி</string>
    <string name="invoke_do_task_button">எனக்காக ஒரு பணியைச் செய்</string>
    <string name="invoke_hold_home_hint">எப்போது வேண்டுமானாலும் ஹோமை அழுத்திப் பிடியுங்கள்</string>
    <string name="invoke_heard_you">கேட்டேன்</string>
    <string name="invoke_heard_promise">பணம் செலுத்துவதற்கு முன் நான் நிறுத்துவேன் — கடைசி தட்டலை நீங்கள் செய்வீர்கள்.</string>
    <string name="invoke_confirm_button">ஆம், தொடருங்கள்</string>
    <string name="invoke_retry_button">இல்லை, மீண்டும் சொல்கிறேன்</string>
    <string name="invoke_plan_template">நான் சரியான ஆப்பைத் திறந்து அதைக் கவனித்துக்கொள்கிறேன்.</string>
    <string name="invoke_read_screen_empty">இந்தத் திரையில் படிக்க எதுவும் கிடைக்கவில்லை.</string>
</resources>
